# Your data and your secrets. Never commit these.
# A LocalDrive install keeps everything it owns under data/, so the whole
# directory is ignored rather than named file by file: a new subdirectory
# added later is ignored by default instead of leaking on the next commit.
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

.env
.env.*
!.env.example
secrets.env
*.pem
*.key
!**/testdata/**/*.key

# Generated at init time from the machine it runs on
server/Caddyfile
server/docker-compose.yml
server/.env

# Backups
*.tar.gz
*.tar.zst
*.bak
backups/

# Go
/server/server
/server/server.exe
/server/server-arm64
/server/localdrive
/server/localdrive.exe
*.exe~
*.test
*.out
vendor/
SHA256SUMS

# Flutter and Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart
*.freezed.dart
*.mocks.dart
localdrive/ios/Pods/
localdrive/ios/Flutter/Flutter.framework
localdrive/ios/Flutter/Flutter.podspec
localdrive/ios/Flutter/Generated.xcconfig
localdrive/ios/Flutter/flutter_export_environment.sh
localdrive/ios/Flutter/ephemeral/
localdrive/android/.gradle/
localdrive/android/local.properties
localdrive/android/key.properties
# anywhere under android/, since CI writes the keystore beside key.properties
# rather than in app/
localdrive/android/**/*.jks
localdrive/android/**/*.keystore
localdrive/android/*.jks
localdrive/android/*.keystore
localdrive/android/github-secrets.txt
localdrive/linux/flutter/ephemeral/
localdrive/windows/flutter/ephemeral/
localdrive/macos/Flutter/ephemeral/
localdrive/macos/Pods/

# Node, Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# The screenshot harness. Local tooling, not part of the product: the stills it
# produces are committed under landing/public/showcase so the site builds
# without it.
capture/

# Editors and OS
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs and scratch
*.log
tmp/
.cache/

# The built Flutter web client, dropped into the server's Caddy root. The
# placeholder page and its readme are committed; the build output is not.
server/web/*
!server/web/README.md
!server/web/index.html

# Firebase (personal deployment, not part of the product)
firebase.json
.firebaserc
firebase-debug.log
firebase-debug.*.log
.firebase/
firebaseConfig.*
**/firebase_options.dart
firebase-*.json
*-firebase-adminsdk-*.json
service-account*.json
**/google-services.json
**/GoogleService-Info.plist
.runtimeconfig.json
apphosting.yaml
dataconnect-generated/

# TestSprite
#
# Verified against the official CLI and MCP documentation on 2026-08-11.
#
# The only TestSprite files this project tracks are the ones it wrote by hand:
# e2e/testsprite/frontend/*.plan.json and e2e/testsprite/backend/*.py. Every
# path below is something a tool generates, and generated output here is not
# harmless: tmp/config.json can carry the API key, code_summary.json is a map of
# the codebase, standard_prd.json and the test plans describe unreleased
# behaviour, and a failure bundle holds screenshots and DOM snapshots of
# whatever account the run used.
#
# Anything ambiguous is ignored. A contributor who wants to share a generated
# artifact can always force-add it deliberately; nobody can un-leak a key.

# --- MCP server output (testsprite_tests/) ---
testsprite_tests/
**/testsprite_tests/

# --- CLI output and local project state (.testsprite/) ---
.testsprite/
**/.testsprite/

# --- credentials, wherever they land ---
.testsprite/credentials
testsprite.credentials
**/testsprite*credentials*
.env.testsprite
testsprite.env

# --- named artifacts, in case any of the above is ever run from elsewhere ---
standard_prd.json
code_summary.json
report_prompt.json
test_results.json
TestSprite_MCP_Test_Report.*
testsprite-mcp-*.json
*.testsprite-report.json
prd_files/

# generated test case files the MCP numbers for you (TC001_..., TC002_...)
TC[0-9][0-9][0-9]_*.py
TC[0-9][0-9][0-9]_*.ts
TC[0-9][0-9][0-9]_*.js

# --- agent skills the CLI generates ---
# Each contributor installs the ones for their own tool with
# `testsprite agent install`, so committing one vendor's copy would date
# instantly and favour a single editor.
.claude/skills/testsprite-*/
.agents/skills/testsprite-*/
.cursor/rules/testsprite-*
.clinerules/testsprite-*
.kiro/skills/testsprite-*/
.windsurf/rules/testsprite-*
.github/instructions/testsprite-*
.claude

# Playwright MCP scratch output from local verification runs
.playwright-mcp/
