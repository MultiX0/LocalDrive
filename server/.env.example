# Local Drive configuration.
#
# `localdrive setup` writes this file for you with every secret filled in.
# Edit it by hand only if you would rather do it yourself.

# ---------------------------------------------------------------------------
# How it is reached
# ---------------------------------------------------------------------------
# The one port everything is served on. Not 443: a machine you self-host on
# usually has other things on it, and 443 is the first port anything else
# will want.
LD_PORT=7443

# Leave empty unless you actually own a domain pointed at this machine. Empty
# is the normal case: the server is reached at this machine's address on your
# network, and Caddy issues its own certificate so the connection is still
# encrypted.
LD_DOMAIN=
LD_TLS_EMAIL=

# The absolute address share links and invite links are built from. Leave it
# empty with no domain; the app fills in whichever address it connected to.
PUBLIC_BASE_URL=

# Exact origins for the web build, comma separated, never a wildcard. Leave
# empty for native clients only.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
# the port the server itself listens on. 7443 is the default and what every
# guide assumes. under docker, compose overrides this to 8080 because caddy
# takes 7443 and proxies to it; you do not need to do anything about that.
LISTEN_ADDR=:7443

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# these are host paths. leave them out entirely and they are derived from
# DATA_DIR, which is the usual arrangement.
#
# do not put container paths like /data/db here. compose sets those itself for
# the container, and on a host /data is the root of the filesystem.
DATA_DIR=./data
# DB_PATH=./data/db/localdrive.sqlite
# LIBRARY_PATH=./data/library
# EXTERNAL_MOUNTS_PATH=./data/external

# the host side of the external mounts bind, used by compose only
EXTERNAL_MOUNTS_HOST=./data/external

# ---------------------------------------------------------------------------
# The two helpers, each reachable only over its own unix socket
# ---------------------------------------------------------------------------
# both are a docker arrangement, and compose sets these paths itself. left
# empty here because outside a container there is no helper listening, and the
# server degrades cleanly to no drive management and no network discovery.
MOUNT_HELPER_SOCKET=
# generate with: openssl rand -base64 32
MOUNT_HELPER_SHARED_SECRET=

LAN_DISCOVERY_SOCKET=
# generate with: openssl rand -base64 32
LAN_DISCOVERY_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# required, at least 32 characters, generate with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Argon2id cost. Raising ARGON2_MEMORY_KIB is the single most effective change
# if the machine has memory to give; 65536 is 64 MB per hash in flight.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=2
ARGON2_THREADS=2

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_CONCURRENCY=4
WORKER_POOL_SIZE=2
MAX_READ_CONNS=4
# 0 means unlimited, which is the sensible default on your own hardware
DEFAULT_QUOTA_BYTES=0

TRASH_RETENTION_DAYS=30
VERSION_RETENTION_COUNT=20
VERSION_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Seeds for the runtime editable settings row, used only on first start
# ---------------------------------------------------------------------------
ENABLE_LAN_DISCOVERY_DEFAULT=true
REQUIRE_DEVICE_APPROVAL_DEFAULT=true
ALLOW_SELF_REGISTRATION_DEFAULT=false

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=
METRICS_ENABLED=false
