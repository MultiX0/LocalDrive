<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Must be the same group as the app's own entitlements. This is the only
	  channel between the two processes: the extension writes a copied file and
	  a manifest here, and the app reads them on launch.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.localdrive</string>
	</array>
</dict>
</plist>
